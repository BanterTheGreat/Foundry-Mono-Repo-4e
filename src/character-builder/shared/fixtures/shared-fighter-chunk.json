      "presentation": {
        "description": "Fighter is a Strength-based Martial Defender. Use tactical cunning and battle prowess to contain the enemy and protect your allies. \"Stickiest\" Defender; hard for enemies to escape you. Variety of build options based on preferred weapon loadout. High damage for a Defender and king of the opportunity attack.",
        "title": "Fighter"
      },
      "sharedData": {
        "abilities": {
          "main": [
            "STRENGTH"
          ],
          "secondary": [
            "CONSTITUTION",
            "DEXTERITY",
