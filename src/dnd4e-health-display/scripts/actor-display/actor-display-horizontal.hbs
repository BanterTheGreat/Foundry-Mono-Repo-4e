<div class="dnd4e-horizontal-actor-display__outer {{#if isGM}}is-gm{{/if}} {{#if experimentalActorHud}}is-experimental-hud{{/if}}">
	<div class="dnd4e-horizontal-actor-display__left-col">
		<div class="dnd4e-horizontal-actor-display__tab-wrap">
			{{#if activeTab}}
				<div class="dnd4e-horizontal-actor-display__drawer {{#if isPowers}}dnd4e-horizontal-actor-display__drawer--powers{{/if}}">
					<div class="dnd4e-horizontal-actor-display__drawer-head">
						<h3>{{activeTabLabel}}</h3>
						<div class="dnd4e-horizontal-actor-display__drawer-head-right">
							<button type="button" class="dnd4e-horizontal-actor-display__drawer-close" data-action="closeDrawer" aria-label="Close">&times;</button>
						</div>
					</div>
					{{#if experimentalActorHud}}<div class="dnd4e-horizontal-actor-display__portrait-search"><input type="search" data-hud-search value="{{hudSearchQuery}}" placeholder="Search {{activeTabLabel}}" aria-label="Search {{activeTabLabel}}"></div>{{/if}}
					{{#if showPowerCategoryTabs}}
						<nav class="dnd4e-horizontal-actor-display__power-categories" aria-label="Power action type">
							{{#each powerCategories}}
								<button type="button" class="{{#if active}}is-active{{/if}}" data-action="selectPowerCategory" data-power-category="{{key}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}">{{name}} <small>{{powers.length}}</small></button>
							{{/each}}
						</nav>
						<div class="dnd4e-horizontal-actor-display__power-search">
							<i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
							<input type="search" value="{{powerSearchQuery}}" placeholder="Search powers" aria-label="Search powers" data-power-search>
						</div>
					{{/if}}
					<div class="dnd4e-horizontal-actor-display__drawer-body">
						{{#if isNpcFeatures}}
							{{#each traitCategories}}
								<section class="dnd4e-horizontal-actor-display__group">
									<h4>{{name}}</h4>
									{{#each features}}
										<button type="button" class="dnd4e-horizontal-actor-display__feature dnd4e-horizontal-actor-display__feature--trait" data-action="feature" data-item-id="{{id}}">
											<i class="fa-solid fa-book" aria-hidden="true"></i>
											<span class="dnd4e-horizontal-actor-display__feature-copy"><strong>{{name}}</strong>{{#if description}}<small>{{{description}}}</small>{{/if}}</span>
										</button>
									{{/each}}
								</section>
							{{/each}}
							{{#each powerCategories}}
								<section class="dnd4e-horizontal-actor-display__group">
									<h4>{{name}}</h4>
									{{#each powers}}
										<div class="dnd4e-horizontal-actor-display__power {{usageClass}}{{#if depleted}} is-depleted{{/if}}" data-power-name="{{name}}">
											<div class="dnd4e-horizontal-actor-display__power-header" data-action="power" data-item-id="{{id}}" {{#unless inlineDetails}}data-item-tooltip data-tooltip-direction="RIGHT" data-power-usage="{{usageClass}}"{{/unless}} role="button" tabindex="0">
												<i class="{{icon}}" aria-hidden="true"></i>
												<strong>{{name}}</strong>
												{{#if showUses}}<small>{{uses}}</small>{{/if}}
												{{#if isExpandable}}<button type="button" class="dnd4e-horizontal-actor-display__power-details-toggle" data-action="togglePowerDetails" data-item-id="{{id}}" aria-expanded="{{#if isExpanded}}true{{else}}false{{/if}}" title="{{#if isExpanded}}Hide details{{else}}Show details{{/if}}"><i class="fa-solid {{#if isExpanded}}fa-chevron-up{{else}}fa-chevron-down{{/if}}" aria-hidden="true"></i></button>{{#if canTargetAutomation}}<button type="button" class="dnd4e-horizontal-actor-display__power-use" data-action="power" data-item-id="{{id}}" title="Use Ability" aria-label="Use {{name}}"><i class="fa-solid fa-crosshairs" aria-hidden="true"></i></button>{{/if}}{{/if}}
												{{#if isNpcPower}}<span class="dnd4e-horizontal-actor-display__npc-power-actions" role="group" aria-label="{{name}} actions">{{#if canTargetAutomation}}<button type="button" class="dnd4e-horizontal-actor-display__power-use" data-action="power" data-item-id="{{id}}" title="Use Ability" aria-label="Use {{name}}"><i class="fa-solid fa-crosshairs" aria-hidden="true"></i></button>{{/if}}<button type="button" data-action="chatPower" data-item-id="{{id}}" aria-label="Show {{name}} in chat" title="Show in Chat"><i class="fa-solid fa-comment" aria-hidden="true"></i></button>{{#if canRollDamage}}<button type="button" data-action="rollPowerDamage" data-item-id="{{id}}" aria-label="Roll {{name}} damage" title="Roll damage"><i class="fa-solid fa-burst" aria-hidden="true"></i></button>{{/if}}</span>{{/if}}
												{{#if depleted}}<button type="button" data-action="refreshPower" data-item-id="{{id}}" title="Refresh power"><i class="fa-solid fa-rotate-right"></i></button>{{/if}}
											</div>
											{{#unless isExpanded}}{{#if flavour}}{{#unless depleted}}<p class="dnd4e-horizontal-actor-display__power-flavour">{{flavour}}</p>{{/unless}}{{/if}}{{/unless}}
											{{#if inlineDetails}}<div class="dnd4e-horizontal-actor-display__power-details {{inlineDetailsClass}}">{{{inlineDetails}}}</div>{{/if}}
										</div>
									{{/each}}
								</section>
							{{/each}}
						{{/if}}

						{{#if showPowerCategoryTabs}}
							{{#each powerCategories}}
								{{#if active}}
								<section class="dnd4e-horizontal-actor-display__group" data-power-category>
									{{#each powers}}
										<div class="dnd4e-horizontal-actor-display__power {{usageClass}}{{#if depleted}} is-depleted{{/if}}" data-action="togglePowerDetails" data-item-id="{{id}}" data-power-name="{{name}}">
											<div class="dnd4e-horizontal-actor-display__power-header" data-action="togglePowerDetails" data-item-id="{{id}}" {{#unless inlineDetails}}data-item-tooltip data-tooltip-direction="RIGHT" data-power-usage="{{usageClass}}"{{/unless}} role="button" tabindex="0">
												<i class="{{icon}}" aria-hidden="true"></i>
												<strong>{{name}}</strong>
												{{#if showUses}}<small>{{uses}}</small>{{/if}}
												{{#if isExpandable}}<button type="button" class="dnd4e-horizontal-actor-display__power-details-toggle" data-action="togglePowerDetails" data-item-id="{{id}}" aria-expanded="{{#if isExpanded}}true{{else}}false{{/if}}" title="{{#if isExpanded}}Hide details{{else}}Show details{{/if}}"><i class="fa-solid {{#if isExpanded}}fa-chevron-up{{else}}fa-chevron-down{{/if}}" aria-hidden="true"></i></button>{{#if canTargetAutomation}}<button type="button" class="dnd4e-horizontal-actor-display__power-use" data-action="power" data-item-id="{{id}}" title="Use Ability" aria-label="Use {{name}}"><i class="fa-solid fa-crosshairs" aria-hidden="true"></i></button>{{/if}}<button type="button" class="dnd4e-horizontal-actor-display__power-chat" data-action="chatPower" data-item-id="{{id}}" aria-label="Show {{name}} in chat" title="Show in Chat"><i class="fa-solid fa-comment" aria-hidden="true"></i></button>{{/if}}
												{{#if isNpcPower}}<span class="dnd4e-horizontal-actor-display__npc-power-actions" role="group" aria-label="{{name}} actions">{{#if canTargetAutomation}}<button type="button" class="dnd4e-horizontal-actor-display__power-use" data-action="power" data-item-id="{{id}}" title="Use Ability" aria-label="Use {{name}}"><i class="fa-solid fa-crosshairs" aria-hidden="true"></i></button>{{/if}}<button type="button" data-action="chatPower" data-item-id="{{id}}" aria-label="Show {{name}} in chat" title="Show in Chat"><i class="fa-solid fa-comment" aria-hidden="true"></i></button>{{#if canRollDamage}}<button type="button" data-action="rollPowerDamage" data-item-id="{{id}}" aria-label="Roll {{name}} damage" title="Roll damage"><i class="fa-solid fa-burst" aria-hidden="true"></i></button>{{/if}}</span>{{/if}}
												{{#if depleted}}<button type="button" data-action="refreshPower" data-item-id="{{id}}" title="Refresh power"><i class="fa-solid fa-rotate-right"></i></button>{{/if}}
											</div>
											{{#unless isExpanded}}{{#if flavour}}{{#unless depleted}}<p class="dnd4e-horizontal-actor-display__power-flavour">{{flavour}}</p>{{/unless}}{{/if}}{{/unless}}
											{{#if inlineDetails}}<div class="dnd4e-horizontal-actor-display__power-details {{inlineDetailsClass}}">{{{inlineDetails}}}</div>{{/if}}
										</div>
									{{/each}}
								</section>
								{{/if}}
							{{/each}}
							<p class="dnd4e-horizontal-actor-display__empty-note" data-power-search-empty hidden>No matching powers.</p>
						{{/if}}

						{{#if isSkills}}
							<div class="dnd4e-horizontal-actor-display__skills">
								{{#each skills}}
									<button type="button" data-action="skill" data-skill="{{key}}" data-hud-entry="{{label}}"><span>{{label}}</span><strong>{{modifier}}</strong></button>
								{{/each}}
							</div>
						{{/if}}

						{{#if isFeatures}}
							{{#each featureCategories}}
								<section class="dnd4e-horizontal-actor-display__group">
									<h4>{{name}}</h4>
									{{#each features}}
										<button type="button" class="dnd4e-horizontal-actor-display__feature" data-action="feature" data-item-id="{{id}}" data-item-tooltip data-tooltip-direction="RIGHT" data-hud-entry="{{name}}">
											<i class="fa-solid fa-book" aria-hidden="true"></i>
											<strong>{{name}}</strong>
										</button>
									{{/each}}
								</section>
							{{/each}}
						{{/if}}

						{{#if isItems}}
							{{#each itemCategories}}
								<section class="dnd4e-horizontal-actor-display__group">
									<h4>{{name}}</h4>
									{{#each items}}
										<div class="dnd4e-horizontal-actor-display__item" data-item-tooltip data-tooltip-direction="RIGHT" data-item-id="{{id}}" data-hud-entry="{{name}}">
											<button type="button" data-action="item" data-item-id="{{id}}">
												<strong>{{name}}</strong>
												{{#if weaponSummary}}<small>{{weaponSummary}}</small>{{/if}}
											</button>
											{{#if canEquip}}<button type="button" class="dnd4e-horizontal-actor-display__equip {{#if equipped}}is-equipped{{/if}}" data-action="toggleEquip" data-item-id="{{id}}" title="{{#if equipped}}Equipped ? click to unequip{{else}}Equip{{/if}}" aria-label="{{#if equipped}}Unequip{{else}}Equip{{/if}} {{name}}" aria-pressed="{{#if equipped}}true{{else}}false{{/if}}">{{#if @root.experimentalActorHud}}<i class="fa-solid {{#if equipped}}fa-check{{else}}fa-shirt{{/if}}" aria-hidden="true"></i>{{else}}{{#if equipped}}Equipped{{else}}Equip{{/if}}{{/if}}</button>{{/if}}
										</div>
									{{/each}}
								</section>
							{{/each}}
						{{/if}}
						{{#if experimentalActorHud}}<p class="dnd4e-horizontal-actor-display__empty-note" data-hud-search-empty hidden>No matching entries.</p>{{/if}}
					</div>
				</div>
			{{/if}}
{{#unless experimentalActorHud}}
			<nav class="dnd4e-horizontal-actor-display__tabs">
				{{#each tabs}}
					<button type="button" class="{{#if active}}is-active{{/if}}" data-action="showSection" data-display-tab="{{key}}" aria-expanded="{{#if active}}true{{else}}false{{/if}}">
						<i class="{{icon}}" aria-hidden="true"></i>
						<span>{{label}}</span>
					</button>
				{{/each}}
			</nav>
{{/unless}}
		</div>

		{{#if experimentalActorHud}}
		<section class="dnd4e-horizontal-actor-display__portrait-hud" aria-label="{{name}}">
			<div class="dnd4e-horizontal-actor-display__portrait-hero">
				<button type="button" class="dnd4e-horizontal-actor-display__portrait-image" data-action="quick" data-command="openSheet" aria-label="Open {{name}}'s character sheet">
					<img src="{{portrait}}" alt="{{name}}" draggable="false">
				</button>
				<div class="dnd4e-horizontal-actor-display__portrait-overlay">
					{{#if hp.status}}<span class="dnd4e-horizontal-actor-display__portrait-status">{{hp.status}}</span>{{/if}}
					<div class="dnd4e-horizontal-actor-display__portrait-name-row">
						<h2 title="{{name}}">{{name}}</h2>
						<label class="dnd4e-horizontal-actor-display__portrait-hp"><input type="number" value="{{hp.value}}" max="{{hp.maximum}}" aria-label="Hit points" data-resource-path="system.attributes.hp.value"><span>/ {{hp.maximum}}</span></label>
						<button type="button" class="dnd4e-horizontal-actor-display__portrait-heal" data-action="quick" data-command="healing" title="Heal" aria-label="Heal"><i class="fa-solid fa-heart" aria-hidden="true"></i></button>
					</div>
					<div class="dnd4e-horizontal-actor-display__health-bar" style="--health-segments: 4" role="img" aria-label="Hit points: {{hp.value}} of {{hp.maximum}}">
						{{#each hp.barSegments}}<span><i style="width: {{percent}}%"></i></span>{{/each}}
					</div>
					<div class="dnd4e-horizontal-actor-display__temp-track" aria-hidden="true"><i style="width: {{hp.tempPercent}}%"></i></div>
				</div>
			</div>
			<div class="dnd4e-horizontal-actor-display__portrait-body">
				<div class="dnd4e-horizontal-actor-display__portrait-resources">
					<label class="is-temp">Temp HP <input type="number" value="{{tempHp}}" min="0" aria-label="Temporary hit points" data-resource-path="system.attributes.temphp.value"></label>
					{{#if hasSurges}}<label class="is-surge">Surges <span><input type="number" value="{{surges.value}}" min="0" max="{{surges.maximum}}" aria-label="Healing surges" data-resource-path="system.details.surges.value"><small>/ {{surges.maximum}}</small></span></label>{{/if}}
				</div>
				{{#if combatDeck.companions.length}}
				<section class="dnd4e-horizontal-actor-display__party" aria-label="Party health">
					<h3>Party health</h3>
					{{#each combatDeck.companions}}
					<div class="dnd4e-horizontal-actor-display__party-member">
						<div class="dnd4e-horizontal-actor-display__party-name"><strong title="{{name}}">{{name}}</strong><span>{{condition}}</span></div>
						<div class="dnd4e-horizontal-actor-display__health-bar" style="--health-segments: 4" role="img" aria-label="{{name}}: {{condition}}">
							{{#each barSegments}}<span><i style="width: {{percent}}%"></i></span>{{/each}}
						</div>
					</div>
					{{/each}}
				</section>
				{{/if}}
			</div>
		</section>
		{{else}}
		<div class="dnd4e-horizontal-actor-display__panel">
			<div class="dnd4e-horizontal-actor-display__charinfo">
				<button type="button" class="dnd4e-horizontal-actor-display__portrait" data-action="quick" data-command="openSheet" title="Open character sheet">
					<img src="{{portrait}}" alt="" draggable="false">
					<span class="dnd4e-horizontal-actor-display__identity-banner">
						<strong title="{{name}}">{{name}}</strong>
						<small>{{levelAndClass}}</small>
					</span>
				</button>
				<div class="dnd4e-horizontal-actor-display__charinfo-text">
					<div class="dnd4e-horizontal-actor-display__hp-dial-wrap">
						<div class="dnd4e-horizontal-actor-display__hp-dial" style="--pct: {{hp.percent}}; --temp-pct: {{hp.tempPercent}}; --surge-pct: {{surges.percent}}" aria-label="Hit points: {{hp.value}} of {{hp.maximum}}. Temporary hit points: {{tempHp}}.{{#if hasSurges}} Healing surges: {{surges.value}} of {{surges.maximum}}.{{/if}}">
							<svg class="dnd4e-horizontal-actor-display__hp-dial-rings" viewBox="0 0 200 200" aria-hidden="true">
								{{#each hp.tempSegments}}<path class="is-temp {{#if filled}}is-filled{{/if}}" d="{{path}}"></path>{{/each}}
								{{#each hp.ringSegments}}<path class="is-hp {{#if filled}}is-filled{{/if}}" d="{{path}}"></path>{{/each}}
								{{#each surges.ringSegments}}<path class="is-surge {{#if filled}}is-filled{{/if}}" d="{{path}}"></path>{{/each}}
							</svg>
							{{#if hasSurges}}<span class="dnd4e-horizontal-actor-display__hp-dial-resource is-surge"><i>Surges</i><span><input type="number" value="{{surges.value}}" min="0" max="{{surges.maximum}}" aria-label="Healing surges" data-resource-path="system.details.surges.value">/{{surges.maximum}}</span></span>{{/if}}
							<span class="dnd4e-horizontal-actor-display__hp-dial-resource is-temp"><i>Temp HP</i><input type="number" value="{{tempHp}}" min="0" aria-label="Temporary hit points" data-resource-path="system.attributes.temphp.value"></span>
							<div class="dnd4e-horizontal-actor-display__hp-dial-inner">
								<input type="number" value="{{hp.value}}" min="0" max="{{hp.maximum}}" data-resource-path="system.attributes.hp.value">
								<span class="dnd4e-horizontal-actor-display__hp-of">of {{hp.maximum}}</span>
							</div>
						</div>
						<div class="dnd4e-horizontal-actor-display__combat-deck">
							<div class="dnd4e-horizontal-actor-display__deck-actions" role="group" aria-label="Combat actions">
								<button type="button" class="dnd4e-horizontal-actor-display__deck-action {{#if horizontalActions.ap.disabled}}is-disabled{{/if}}" data-action="quick" data-command="actionPoint" {{#if horizontalActions.ap.disabled}}disabled{{/if}} title="Spend or use an Action Point" aria-label="Spend or use an Action Point"><i class="fa-solid fa-bolt" aria-hidden="true"></i><span>AP</span></button>
								<div class="dnd4e-horizontal-actor-display__action-slot"><button type="button" class="dnd4e-horizontal-actor-display__deck-action {{#if isHealOpen}}is-open{{/if}}" data-action="toggleDropdown" data-dropdown="heal" title="Heal and Second Wind" aria-label="Heal and Second Wind"><i class="fa-solid fa-heart" aria-hidden="true"></i><span>Heals</span></button>{{#if isHealOpen}}<div class="dnd4e-horizontal-actor-display__dropdown-menu">{{#each horizontalActions.heal}}<button type="button" data-action="quick" data-command="{{command}}">{{label}}</button>{{/each}}</div>{{/if}}</div>
								<div class="dnd4e-horizontal-actor-display__action-slot"><button type="button" class="dnd4e-horizontal-actor-display__deck-action {{#if isSaveOpen}}is-open{{/if}}" data-action="toggleDropdown" data-dropdown="save" title="Saving Throw and Death Save" aria-label="Saving Throw and Death Save"><i class="fa-solid fa-star" aria-hidden="true"></i><span>Saves</span></button>{{#if isSaveOpen}}<div class="dnd4e-horizontal-actor-display__dropdown-menu">{{#each horizontalActions.save}}<button type="button" data-action="quick" data-command="{{command}}" {{#if disabled}}disabled{{/if}}>{{label}}{{#if detail}}<small>{{detail}}</small>{{/if}}</button>{{/each}}</div>{{/if}}</div>
								<div class="dnd4e-horizontal-actor-display__action-slot"><button type="button" class="dnd4e-horizontal-actor-display__deck-action {{#if isRestOpen}}is-open{{/if}}" data-action="toggleDropdown" data-dropdown="rest" title="Short Rest and Extended Rest" aria-label="Short Rest and Extended Rest"><i class="fa-solid fa-moon" aria-hidden="true"></i><span>Rests</span></button>{{#if isRestOpen}}<div class="dnd4e-horizontal-actor-display__dropdown-menu">{{#each horizontalActions.rest}}<button type="button" data-action="quick" data-command="{{command}}">{{label}}</button>{{/each}}</div>{{/if}}</div>
							</div>
							{{#unless experimentalActorHud}}
							<div class="dnd4e-horizontal-actor-display__pace-bar">
								<button type="button" data-action="quick" data-command="initiative" title="Roll initiative"><i class="fa-solid fa-compass" aria-hidden="true"></i><span>Init</span><b>{{combatDeck.initiative}}</b></button>
								<button type="button" data-action="quick" data-command="openSheet" title="Open character sheet"><i class="fa-solid fa-person-running" aria-hidden="true"></i><span>Speed</span><b>{{combatDeck.speed}}</b></button>
							</div>
							{{/unless}}
							{{#if combatDeck.companions.length}}
								<section class="dnd4e-horizontal-actor-display__companions" aria-label="Companions">
									<h3>Companions</h3>
									<div class="dnd4e-horizontal-actor-display__companion-list">
										{{#each combatDeck.companions}}
											<div class="dnd4e-horizontal-actor-display__companion">
												<div class="dnd4e-horizontal-actor-display__companion-radial" role="img" aria-label="{{healthLabel}}">{{#each segments}}<i class="{{#if filled}}is-filled{{/if}}"></i>{{/each}}</div>
												<strong title="{{name}}">{{name}}</strong><small title="{{className}}">{{className}}</small>
											</div>
										{{/each}}
									</div>
								</section>
							{{/if}}
						</div>
					</div>
				</div>
			</div>
		</div>
		{{/if}}
	</div>

	{{#unless isGM}}
		{{#if isInCombat}}
		<div class="dnd4e-horizontal-actor-display__turn-controls">
				<button type="button" class="dnd4e-horizontal-actor-display__end-turn" data-action="quick" data-command="endTurn" {{#unless isCurrentTurn}}disabled{{/unless}} title="{{#if isCurrentTurn}}End your turn{{else}}Not your turn{{/if}}">
					<i class="fa-solid fa-hourglass-end" aria-hidden="true"></i> End Turn
				</button>
		</div>
		{{/if}}
	{{/unless}}

</div>
