<div class="dnd4e-strategy-overlay">
	{{#if environmentNotes.length}}
		<section class="dnd4e-strategy-overlay__environment">
			<header class="dnd4e-strategy-overlay__environment-header">
				<i class="fa-solid fa-map-location-dot" aria-hidden="true"></i>
				<span>Environment</span>
			</header>
			<ul class="dnd4e-strategy-overlay__environment-list">
				{{#each environmentNotes}}
					<li>{{this}}</li>
				{{/each}}
			</ul>
		</section>
	{{/if}}
	{{#if turnPointer}}
		<section class="dnd4e-strategy-overlay__turn-pointer">
			<header class="dnd4e-strategy-overlay__turn-pointer-header">
				<img src="{{turnPointer.combatantImg}}" alt="">
				<div>
					<span>Now Acting</span>
					<h2>{{turnPointer.combatantName}}</h2>
				</div>
			</header>
			{{#if turnPointer.notes.length}}
				<ul class="dnd4e-strategy-overlay__turn-pointer-list">
					{{#each turnPointer.notes}}
						<li>{{this}}</li>
					{{/each}}
				</ul>
			{{else}}
				<p class="dnd4e-strategy-overlay__empty">No pointers for this turn.</p>
			{{/if}}
			<footer class="dnd4e-strategy-overlay__turn-actions">
				<button type="button" data-action="previousTurn" class="dnd4e-strategy-overlay__turn-nav" title="Previous turn">
					<i class="fa-solid fa-backward-step" aria-hidden="true"></i> Previous
				</button>
				<button type="button" data-action="nextTurn" class="dnd4e-strategy-overlay__end-turn">
					<i class="fa-solid fa-hourglass-end" aria-hidden="true"></i> Next
				</button>
				<button type="button" data-action="endCombat" class="dnd4e-strategy-overlay__end-combat" title="End combat">
					<i class="fa-solid fa-flag-checkered" aria-hidden="true"></i>
				</button>
			</footer>
		</section>
	{{/if}}
</div>
