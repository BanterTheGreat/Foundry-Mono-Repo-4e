<section class="power-targeting__body">
	<div class="power-targeting__heading"><strong>{{powerName}}</strong><button type="button" data-action="toggleDetails" aria-expanded="{{showDetails}}" title="Toggle power details"><i class="fa-solid fa-book-open" aria-hidden="true"></i> Details</button></div>
	{{#unless resolved}}
	<label class="power-targeting__origin">Origin <select data-origin-selector {{#if busy}}disabled{{/if}}>{{#each originChoices}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
	{{/unless}}
	{{#if showDetails}}<div class="power-targeting__card">{{{card}}}</div>{{/if}}
	{{#if resolved}}
	{{#if beforeAttackRules}}<details class="power-targeting__before"><summary>Before attack</summary><div class="power-targeting__resolution" role="region" aria-label="Before attack power rules" tabindex="0">{{{beforeAttackRules}}}</div></details>{{/if}}
	<div class="power-targeting__result-stage"><p class="power-targeting__status" role="status">{{status}}</p><span class="power-targeting__result-count">{{results.length}} targets</span></div>
	<ul class="power-targeting__targets power-targeting__results">
		{{#each results}}
		<li class="power-targeting__result">
			<div class="power-targeting__result-summary">
				<div class="power-targeting__target-identity">{{#if img}}<img src="{{img}}" alt="" width="26" height="26">{{/if}}<span class="power-targeting__target-name">{{name}}</span>{{#if ../reviewing}}<button type="button" data-action="removeReviewTarget" data-token-id="{{tokenId}}" aria-label="Remove {{name}}" {{#if ../busy}}disabled{{/if}}>×</button>{{/if}}</div>
				<strong class="power-targeting__verdict power-targeting__verdict--{{outcome}}">{{total}} &middot; {{label}}</strong>
			</div>
			{{#if canAdjust}}
			<div class="power-targeting__result-adjustment">
				<label>Mod <input type="number" step="any" value="{{modifier}}" aria-label="Post-roll modifier for {{name}}" {{#if ../busy}}disabled{{/if}}></label>
				<button type="button" data-action="adjustResult" data-message-id="{{messageId}}" data-roll-index="{{rollIndex}}" aria-label="Apply modifier for {{name}}" {{#if ../busy}}disabled{{/if}}>Apply</button>
			</div>
			{{else}}
			<span class="power-targeting__result-confirmed"><i class="fa-solid fa-check" aria-hidden="true"></i> {{#if fixedOutcome}}Automatic{{else}}Confirmed{{/if}}</span>
			{{/if}}
		</li>
		{{else}}
		<li class="power-targeting__empty">{{#if noTargets}}All targets removed from this attack.{{else}}No visible target results. Check the attack message in chat.{{/if}}</li>
		{{/each}}
	</ul>
	{{#if reviewing}}<p class="power-targeting__review-hint">Adjust any attack total, then confirm all results.</p>{{else}}
	{{#unless noTargets}}
	{{#if resolutionRules}}<div class="power-targeting__resolution" role="region" aria-label="Post-attack power rules" tabindex="0">{{{resolutionRules}}}</div>{{/if}}
	<p class="power-targeting__range power-targeting__damage-summary">{{#if hasDamageTotal}}<span><strong>{{damageTotal}}</strong> damage rolled</span>{{/if}}<span>{{#if needsDamage}}One shared damage roll · Includes miss damage{{else}}Apply damage and effects manually{{/if}}</span></p>
	{{else}}<p class="power-targeting__range">No targets remain. This power’s use is already spent.</p>{{/unless}}
	{{/if}}
	<footer>
		{{#if reviewing}}<button type="button" data-action="confirmResults" class="is-ready" {{#if busy}}disabled{{/if}}>Confirm Results</button>{{/if}}
		{{#if needsDamage}}<button type="button" data-action="rollDamage" class="is-ready" {{#if busy}}disabled{{/if}}><i class="fa-solid fa-dice" aria-hidden="true"></i> Roll Damage</button>
		{{/if}}
		{{#if canComplete}}<button type="button" data-action="complete" class="is-ready" {{#if busy}}disabled{{/if}}><i class="fa-solid fa-check" aria-hidden="true"></i> Complete</button>{{/if}}
	</footer>
	{{else}}
	{{#if beforeAttackRules}}<div class="power-targeting__resolution" role="region" aria-label="Before attack power rules" tabindex="0"><div class="power-targeting__rules-label">Before attack</div>{{{beforeAttackRules}}}</div>{{/if}}
	<div class="power-targeting__placement">
		{{#if summon}}
		<p class="power-targeting__range">Summon square · Range {{range}}</p>
		<p>{{#if placementLocked}}Placement locked. Confirm to summon the configured actor.{{else}}Select a square on the canvas, then confirm to summon.{{/if}}</p>
		<div class="power-targeting__controls"><button type="button" data-action="reposition" {{#if busy}}disabled{{/if}}>Reposition</button></div>
		{{else}}
		{{#if wall}}
		<p class="power-targeting__range">Wall · Range {{range}} squares</p>
		<p><strong>{{wallCount}} / {{areaSize}} squares</strong> · Click or drag through side-adjacent squares. White marks the origin.</p>
		{{#if wallHint}}<p role="status">{{wallHint}}</p>{{/if}}
		<div class="power-targeting__controls"><button type="button" data-action="undoWall" {{#if busy}}disabled{{/if}}>Undo square</button><button type="button" data-action="clearWall" {{#if busy}}disabled{{/if}}>Clear wall</button><button type="button" data-action="selectArea" {{#if busy}}disabled{{/if}}>Select wall targets</button></div>
		{{else}}
		{{#if area}}
		<p class="power-targeting__range">{{areaLabel}} {{areaSize}} · Range {{range}} squares</p>
		<p>{{#if placementLocked}}<strong>Placement locked.</strong> Adjust targets with normal targeting controls.{{else}}Move the pointer on the canvas, then click to lock placement.{{/if}}</p>
		<div class="power-targeting__controls"><button type="button" data-action="selectArea" {{#if busy}}disabled{{/if}}>Select area targets</button>{{#if movableArea}}<button type="button" data-action="reposition" {{#if busy}}disabled{{/if}}>Reposition</button>{{/if}}</div>
		{{else}}
		<p class="power-targeting__range">Range <strong>{{normalRange}}{{#if longRange}} / {{range}}{{/if}}</strong> squares</p>
		<p>Use normal targeting controls to select or remove targets.</p>
		{{#if longRange}}<p class="power-targeting__range">Gold: normal range · Blue: long range</p>{{/if}}
		{{/if}}
		{{/if}}
		{{/if}}
	</div>
	{{#if problems}}<ul class="power-targeting__warnings" aria-live="polite">{{#each problems}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
	<p class="power-targeting__status" aria-live="polite">{{#unless summon}}<strong>{{selected}}{{#if countedTargets}} / {{countModeLabel}} {{required}}{{/if}} targets</strong> · {{/unless}}{{status}}</p>
	{{#unless summon}}
	<ul class="power-targeting__targets">
		{{#each targets}}
		<li class="{{#if invalid}}is-invalid{{/if}}"><div class="power-targeting__target-identity">{{#if img}}<img src="{{img}}" alt="" width="26" height="26">{{/if}}<span class="power-targeting__target-name">{{name}}{{#each warnings}}<small><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> {{this}}</small>{{/each}}</span></div><button type="button" data-action="removeTarget" data-token-id="{{id}}" {{#if ../busy}}disabled{{/if}} aria-label="Remove {{name}}">×</button></li>
		{{else}}
		<li class="power-targeting__empty">No targets selected. Use normal canvas targeting controls.</li>
		{{/each}}
	</ul>
	{{/unless}}
	<details class="power-targeting__manual">
		<summary>Manual checks · cover, elevation and special rules</summary>
		{{#if areaOriginHint}}<p>{{areaOriginHint}} Maximum placement range: {{range}} squares.</p>{{/if}}
		<p>Check cover, line of effect, elevation and special power requirements manually. Target count, range and area membership warnings are advisory.</p>
		{{#if wall}}<p>Confirm when the footprint is complete. Check wall height manually.</p>{{/if}}
		{{#if summon}}<p>Cancel creates no token.</p>{{/if}}
	</details>
	<footer>
		<button type="button" data-action="cancel" {{#unless cancellable}}disabled{{/unless}}>Cancel</button>
		<button type="button" data-action="attack" class="{{#if ready}}is-ready{{/if}}" {{#if busy}}disabled{{/if}}>{{#if hasAttack}}<i class="fa-solid fa-dice-d20" aria-hidden="true"></i> Attack…{{else}}<i class="fa-solid fa-check" aria-hidden="true"></i> {{#if summon}}Confirm summon{{else}}Confirm{{/if}}{{/if}}</button>
	</footer>
	{{/if}}
</section>
