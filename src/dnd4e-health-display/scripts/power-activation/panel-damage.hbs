{{#unless noTargets}}
	{{#if damageCards.length}}
	<ul class="power-targeting__damage-rolls" style="--damage-outcomes: {{damageCards.length}}" aria-label="Shared damage rolls">
		{{#each damageCards}}
		<li class="power-targeting__damage-card power-targeting__damage-card--{{type}}">
			<header><strong>{{title}}</strong><small>{{targetLabel}}</small></header>
			<div class="power-targeting__outcome-total"><small>{{#if ../healing}}Total healing{{else}}Total damage{{/if}}</small><strong>{{total}}</strong></div>
			{{#if derived}}
			<div class="power-targeting__derived-miss"><span>½ Hit</span><span>{{sourceTotal}} ÷ 2</span><small>Rounded down</small></div>
			{{else}}
			<div class="power-targeting__damage-calculation{{#if critical}} power-targeting__damage-calculation--crit{{/if}}" aria-label="Damage calculation">
				{{#if critical}}
				<div><strong>{{criticalMaximum}}</strong><small>MAX</small></div>
				<span aria-hidden="true">+</span>
				<div><strong>{{criticalDice}}</strong><small title="{{fullRollFormula}}">{{criticalDiceFormula}}</small></div>
				{{else}}
				<div><strong>{{rolled}}</strong><small title="{{fullRollFormula}}">{{rollFormula}}</small></div>
				{{/if}}
				<span aria-hidden="true">+</span>
				<div><strong>{{calculationModifier}}</strong><small>Mod</small></div>
				<span aria-hidden="true">=</span>
				<div><strong>{{total}}</strong><small>Total</small></div>
			</div>
			<div class="power-targeting__shared-modifier">
				{{#if ../reviewingDamage}}<div class="power-targeting__result-adjustment"><label><span>Adjust damage</span><input type="text" data-damage-modifier data-message-id="{{messageId}}" value="{{modifier}}" placeholder="+0" aria-label="{{title}} roll modifier" {{#if ../busy}}disabled{{/if}}></label><button type="button" data-action="adjustDamage" data-message-id="{{messageId}}" aria-label="Apply {{title}} roll modifier" {{#if ../busy}}disabled{{/if}}>Apply</button></div>
				{{else}}<span>Adjust damage</span><span class="power-targeting__modifier-summary">{{#if modifier}}{{modifier}}{{else}}+0{{/if}}</span>{{/if}}
			</div>
			{{/if}}
		</li>
		{{/each}}
	</ul>
	{{/if}}
	{{#if zeroMiss}}<div class="power-targeting__zero-miss"><span>Miss damage</span><strong>0</strong></div>{{/if}}
{{/unless}}
