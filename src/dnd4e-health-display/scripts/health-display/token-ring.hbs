<div class="dnd4e-token-ring__frame{{#if role}} is-{{role.key}} has-role{{/if}}" style="width: {{outer}}px; height: {{outer}}px;">
	<svg class="dnd4e-token-ring__svg" viewBox="0 0 {{outer}} {{outer}}" aria-hidden="true">
		<circle class="dnd4e-token-ring__hover-ring" cx="{{centre}}" cy="{{centre}}" r="{{radius}}"/>
	</svg>

	<div class="dnd4e-token-ring__tag" style="top: {{tagTop}}px;">
		<svg class="dnd4e-token-ring__tag-shape" aria-hidden="true"></svg>
		<div class="dnd4e-token-ring__gems" role="img" aria-label="{{healthLabel}}">
			{{#each gems}}
				<span class="dnd4e-token-ring__gem{{#if filled}} is-filled{{/if}}"></span>{{#if gapAfter}}<span class="dnd4e-token-ring__gem-gap"></span>{{/if}}
			{{/each}}
		</div>
		<div class="dnd4e-token-ring__namerow">
			{{#if role.icon}}
				<span class="dnd4e-token-ring__role" title="{{role.label}}" aria-label="{{role.label}}">
					<i class="{{role.icon}}" aria-hidden="true"></i>
				</span>
			{{/if}}
			<span class="dnd4e-token-ring__name{{#if defeated}} is-defeated{{/if}}">{{name}}</span>
		</div>
	</div>

	{{#if effects.length}}
		<span class="dnd4e-token-ring__stub" aria-hidden="true"></span>
		<ul class="dnd4e-token-ring__strip{{#if conditionsOnly}} is-conditions-only{{/if}}" aria-label="Temporary effects and conditions">
			{{#each effects}}
				<li class="dnd4e-token-ring__effect{{#if soon}} is-soon{{/if}}{{#if description}} has-description{{/if}}">
					<img class="dnd4e-token-ring__effect-icon" src="{{img}}" alt="">
					<span class="dnd4e-token-ring__effect-title">{{title}}</span>
					<span class="dnd4e-token-ring__effect-ending is-{{endingKind}}">
						{{#if soon}}<i class="fa-solid fa-hourglass-end" aria-hidden="true"></i>{{/if}}
						{{#if isEncounter}}
							<i class="fa-solid fa-infinity" aria-hidden="true"></i><span class="dnd4e-token-ring__sr">{{endingLabel}}</span>
						{{else if isOpenEnded}}
							<span aria-hidden="true">&mdash;</span><span class="dnd4e-token-ring__sr">No set end</span>
						{{else}}
							{{endingLabel}}
						{{/if}}
					</span>
					{{#if description}}
						<span class="dnd4e-token-ring__effect-description">{{description}}</span>
					{{/if}}
				</li>
			{{/each}}
			{{#if overflow}}
				<li class="dnd4e-token-ring__more">+{{overflow}} more</li>
			{{/if}}
		</ul>
	{{/if}}
</div>
