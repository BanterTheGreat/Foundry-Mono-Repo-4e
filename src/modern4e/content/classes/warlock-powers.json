              "kind": "ACTOR",
              "text": "The power user."
            }
          },
          "range": {
            "type": "RULES_TEXT",
            "text": "Special"
          },
          "blocks": [
            {
              "id": "row-1",
              "type": "effect",
              "label": "Effect",
              "text": "When an enemy under your Warlock's Curse is reduced to 0 hit points or fewer, add 1 to your Darkspiral Aura. Your Darkspiral Aura has a starting value of 0, and it resets to 0 when you take a short rest or an extended rest."
            },
            {
              "id": "row-2",
              "type": "effect",
              "label": "Hit",
              "text": "1d6 necrotic and psychic damage to that enemy for each point of your Darkspiral Aura's current value.",
              "scaling": [
                {
                  "atLevel": 11,
                  "text": "1d8 damage."
                },
                {
                  "atLevel": 21,
                  "text": "1d10 damage."
                }
              ]
            },
            {
              "id": "row-3",
              "type": "effect",
              "label": "Special",
              "text": "If this attack deals less than 12 damage, the value of your Darkspiral Aura becomes 0.\n\nIf this attack deals 12 damage or more, you can cause the enemy to be weakened for its attack (which means the attack deals half damage), and the value of your Darkspiral Aura becomes 1."
            }
          ],
          "trigger": "When an enemy under your Warlock's Curse makes a melee attack or a ranged attack against you"
        }
      ]
