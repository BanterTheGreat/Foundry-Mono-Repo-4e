    {
      "id": "modern4e.power.warlock-darkspiral-aura",
      "title": "Darkspiral Aura",
      "description": "When an enemy under your Warlock's Curse is reduced to 0 hit points or fewer, add 1 to your Darkspiral Aura. Your Darkspiral Aura has a starting value of 0, and it resets to 0 when you take a short rest or an extended rest.",
      "access": {
        "type": "always"
      },
      "prerequisites": {
        "type": "always"
      },
      "selection": {
        "maximum": 1,
