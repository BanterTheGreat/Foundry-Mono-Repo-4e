        "ARCANE",
        "NECROTIC",
        "PSYCHIC"
      ],
      "choices": [],
      "flavor": "As your cursed enemies fall in battle, your Darkspiral Aura grows in power. You can unleash it on an enemy, blasting its mind and body.",
      "activations": [
        {
          "id": "use",
          "availability": "ENTRY",
