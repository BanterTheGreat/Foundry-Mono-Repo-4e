    {
      "id": "modern4e.power.warlock-warlock-s-curse",
      "title": "Warlock's Curse",
      "description": "You place a Warlock's Curse on the enemy. If you hit a cursed enemy with an attack, you deal +1d6 damage. You decide whether to apply the extra damage after making the damage roll. You can deal this extra damage to each enemy only once per turn.\n\nA Warlock's Curse remains in effect until the end of the encounter or until the cursed enemy drops to 0 hit points or fewer. You can't place a Warlock's Curse on a creature that is already affected by your or another character's Warlock's Curse.",
      "access": {
        "type": "always"
      },
      "prerequisites": {
        "type": "always"
      },
      "selection": {
        "maximum": 1,
