{
  "steps": [
    {
      "id": "modern4e.creation.ancestry",
      "title": "Choose an Ancestry",
      "description": "Choose a ancestry from Ancestries, this will give you 2 passive abilities and an encounter power.",
      "required": true
    },
    {
      "id": "modern4e.creation.background",
      "title": "Create a Background",
      "description": "Create a background by selecting an environment and an upbringing, and mark down the skills chosen.",
      "required": true
    },
    {
      "id": "modern4e.creation.class",
      "title": "Choose a Class",
      "description": "Choose a class, this will decide your main playstyle during combat. Make sure you write down any choices you make during class selection, such as powers selected.",
      "required": true
    },
    {
      "id": "modern4e.creation.equipment",
      "title": "Gather your Equipment",
      "description": "Choose your starting equipment from Equipment. Make sure to write down any choices you make during equipment selection, such as weapon types. You may select one or two weapons, an armor type, a shield and an implement you are proficent in.",
      "required": true
    },
    {
      "id": "modern4e.creation.skills",
      "title": "Select 2 Skills",
      "description": "Choose 2 skills to become proficient in, these are the skills your character picked up between the time of their background and becoming an adventurer.",
      "required": true
    },
    {
      "id": "modern4e.creation.theme",
      "title": "Choose a Theme",
      "description": "Themes are a kind of subtrack you can pick which come with some benefits. You may choose one.",
      "required": false
    },
    {
      "id": "modern4e.creation.feat",
      "title": "Choose a Feat",
      "description": "You may choose 1 Feat from either your ancestry, class or the general Feats list.",
      "required": true
    }
